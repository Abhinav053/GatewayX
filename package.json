{
  "name": "payment-gateway-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed payment gateway orchestration platform",
  "workspaces": [
    "services/*",
    "shared"
  ],
  "scripts": {
    "dev:orchestrator": "npm run dev --workspace=payment-orchestrator",
    "dev:metrics": "npm run dev --workspace=metrics-service",
    "dev:experiments": "npm run dev --workspace=experiment-service",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0"
  },
  "devDependencies": {
    "jest": "^30.0.5",
    "prisma": "^6.15.0",
    "supertest": "^7.1.1"
  }
}
